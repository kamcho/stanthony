# =============================================================================
# Shared Hostinger VPS (Soma Smart at /srv/elearning, TKT/Metrolinks at /srv/metrolinks)
# Copy on the server:  cp .env.hostinger.example .env && nano .env
# App path: /srv/stanthony
# Cutover takes the public front door from Metrolinks but does NOT delete TKT.
# =============================================================================

SECRET_KEY=CHANGE-ME-generate-with-openssl-rand-hex-32

DEBUG=False
TIME_ZONE=Africa/Nairobi
LOG_LEVEL=INFO

ALLOWED_HOSTS=stanthonyhcabossi.org,www.stanthonyhcabossi.org,185.170.196.219,127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=https://stanthonyhcabossi.org,https://www.stanthonyhcabossi.org

SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# --- Postgres (SEPARATE from elearning + metrolinks) ---
DB_ENGINE=postgres
DB_NAME=stanthony
DB_USER=stanthony
DB_PASSWORD=CHANGE-ME-strong-db-password
DB_HOST=127.0.0.1
DB_PORT=5432

GUNICORN_WORKERS=2
GUNICORN_BIND=unix:/run/stanthony/stanthony.sock

# Namecheap Private Email (mailbox password required)
EMAIL_HOST=mail.privateemail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=info@stanthonyhcabossi.org
EMAIL_HOST_PASSWORD=14178215aA!
DEFAULT_FROM_EMAIL="St. Anthony Health Centre" <info@stanthonyhcabossi.org>
CONTACT_NOTIFY_EMAIL=info@stanthonyhcabossi.org
