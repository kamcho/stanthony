# =============================================================================
# Shared Hostinger VPS (Soma Smart at /srv/elearning, TKT/Metrolinks at /srv/metrolinks)
# Copy on the server:  cp .env.hostinger.example .env && nano .env
# App path: /srv/stanthony
# Cutover takes the public front door from Metrolinks but does NOT delete TKT.
# =============================================================================

SECRET_KEY=CHANGE-ME-generate-with-openssl-rand-hex-32

DEBUG=False
TIME_ZONE=Africa/Nairobi
LOG_LEVEL=INFO

# Use hospital domain when ready. Until then IP + temporary hosts work.
ALLOWED_HOSTS=185.170.196.219,127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://185.170.196.219

# After certbot / real domain:
# ALLOWED_HOSTS=stanthonysabossi.example,www.stanthonysabossi.example,185.170.196.219,127.0.0.1,localhost
# CSRF_TRUSTED_ORIGINS=https://stanthonysabossi.example,https://www.stanthonysabossi.example

SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# --- Postgres (SEPARATE from elearning + metrolinks) ---
DB_ENGINE=postgres
DB_NAME=stanthony
DB_USER=stanthony
DB_PASSWORD=CHANGE-ME-strong-db-password
DB_HOST=127.0.0.1
DB_PORT=5432

GUNICORN_WORKERS=2
GUNICORN_BIND=unix:/run/stanthony/stanthony.sock
